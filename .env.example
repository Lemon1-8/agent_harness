# Agent Harness 环境配置模板
#
# 用法：cp .env.example .env，然后至少填入 ANTHROPIC_API_KEY
#
# 优先级（低 → 高）：
#   代码默认值 → ~/.harness/config.toml → .harness/config.toml → .env → 系统环境变量
# 本文件的值不会覆盖已存在的系统环境变量（load_dotenv(override=False)）。

# ── 必填 ─────────────────────────────────────────────────────
# 缺失时守护进程拒绝启动——即使只跑 `harness ping` 也需要，
# 因为 provider 在 server.start() 之前就构造了。
# 使用第三方 Anthropic 兼容端点（如 DeepSeek）时，配合下面的 ANTHROPIC_BASE_URL。
ANTHROPIC_API_KEY=

# ── Core 守护进程 ────────────────────────────────────────────
HARNESS_HOST=127.0.0.1
HARNESS_PORT=7437
# 容器内 HARNESS_HOST 必须为 0.0.0.0，否则 docker 端口映射无法到达

# ── 日志 ─────────────────────────────────────────────────────
HARNESS_LOG_LEVEL=INFO
HARNESS_LOG_FILE=~/.harness/logs/core.log
HARNESS_LOG_FORMAT=text
# HARNESS_LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
# HARNESS_LOG_FILE:  留空则仅输出 stderr，不写文件
# HARNESS_LOG_FORMAT: text（人工可读）| json（结构化，适合日志聚合）

# ── LLM ──────────────────────────────────────────────────────
# HARNESS_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=
#   第三方 Anthropic 兼容端点。例如 DeepSeek：
#     ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#     HARNESS_LLM_DEFAULT_MODEL=deepseek-v4-pro
#   注意：不显式设置模型名时，服务端会把未知模型静默回退到便宜档位。

# ── Agent ────────────────────────────────────────────────────
# HARNESS_MAX_STEPS=20
#   单次运行的最大步数（正整数）

# ── 追踪 ─────────────────────────────────────────────────────
# HARNESS_TRACE_ENABLED=true
# HARNESS_TRACE_FILE=~/.harness/traces/daemon.jsonl
# HARNESS_TRACE_INCLUDE_LLM_PAYLOAD=true
#   最后一个设为 false 时，LLM 记录只保留摘要，不写完整载荷

# ── 权限 ─────────────────────────────────────────────────────
# HARNESS_PERMISSION_TIMEOUT_S=60.0
#   权限询问超时秒数，0 表示不超时

# ── 上下文压缩 ───────────────────────────────────────────────
# HARNESS_COMPACT_THRESHOLD=0.0
#   自动压缩触发阈值，取值 0~1；0 表示关闭
# HARNESS_COMPACT_TOOL_LIMIT=8000
# HARNESS_COMPACT_TOOL_KEEP=4000
#   ⚠️ 这两个键目前不生效：代码实际使用的是 compact/budget.py 里的模块常量

# ── TUI ──────────────────────────────────────────────────────
# HARNESS_TUI_LOG_FILE=~/.harness/logs/tui.log

# ── 配置文件路径 ─────────────────────────────────────────────
# HARNESS_CONFIG=~/.harness/config.toml
#   设置后只读该文件，跳过 ~/.harness/config.toml 和 .harness/config.toml
